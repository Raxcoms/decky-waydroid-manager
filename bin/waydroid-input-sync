#!/usr/bin/python3
import os
from pathlib import Path
import stat
import subprocess
import tempfile
import time


LXC_PATH = "/var/lib/waydroid/lxc"
ANDROID_INPUT_GID = 1004


def container_pid() -> str | None:
    try:
        result = subprocess.run(
            ["lxc-info", "-P", LXC_PATH, "-n", "waydroid", "-pH"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except subprocess.SubprocessError:
        return None
    pid = result.stdout.strip()
    return pid if result.returncode == 0 and pid.isdecimal() and int(pid) > 0 else None


def steam_controllers() -> dict[str, int]:
    controllers = {}
    for event in Path("/sys/class/input").glob("event*"):
        try:
            vendor = (event / "device/id/vendor").read_text().strip().lower()
            product = (event / "device/id/product").read_text().strip().lower()
            source = Path("/dev/input") / event.name
            info = source.stat()
        except OSError:
            continue
        if vendor == "28de" and product == "11ff" and stat.S_ISCHR(info.st_mode):
            controllers[event.name] = info.st_rdev
    return controllers


def publish_node(inputs: Path, name: str, device: int) -> None:
    destination = inputs / name
    try:
        info = destination.lstat()
        if stat.S_ISCHR(info.st_mode) and info.st_rdev == device:
            return
        destination.unlink()
    except FileNotFoundError:
        pass

    with tempfile.TemporaryDirectory(prefix=".waydroid-manager-", dir=inputs.parent) as staging:
        source = Path(staging) / name
        os.mknod(source, stat.S_IFCHR | 0o660, device)
        os.chown(source, 0, ANDROID_INPUT_GID)
        source.chmod(0o660)
        os.link(source, destination)


def remove_node(inputs: Path, name: str, device: int) -> None:
    try:
        info = (inputs / name).lstat()
        if stat.S_ISCHR(info.st_mode) and info.st_rdev == device:
            (inputs / name).unlink()
    except FileNotFoundError:
        pass


def sync(inputs: Path, controllers: dict[str, int], published: dict[str, int]) -> dict[str, int]:
    for name, device in published.items():
        if controllers.get(name) != device:
            remove_node(inputs, name, device)
    for name, device in controllers.items():
        publish_node(inputs, name, device)
    return controllers


def main() -> None:
    active_pid = None
    published: dict[str, int] = {}
    while True:
        pid = container_pid()
        if pid != active_pid:
            active_pid = pid
            published = {}
        if pid:
            inputs = Path("/proc") / pid / "root/dev/input"
            try:
                published = sync(inputs, steam_controllers(), published)
            except OSError:
                published = {}
        time.sleep(1)


if __name__ == "__main__":
    main()
