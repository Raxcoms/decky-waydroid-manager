#!/usr/bin/python3
import os
from pathlib import Path
import stat
import subprocess
import tempfile
import time


LXC_PATH = "/var/lib/waydroid/lxc"
ANDROID_INPUT_GID = 1004
STEAM_VENDOR = "28de"
STEAM_PRODUCT = "11ff"


def container_pid() -> str | None:
    try:
        result = subprocess.run(
            ["lxc-info", "-P", LXC_PATH, "-n", "waydroid", "-pH"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except subprocess.SubprocessError:
        return None
    pid = result.stdout.strip()
    return pid if result.returncode == 0 and pid.isdecimal() and int(pid) > 0 else None


def input_identity(name: str) -> tuple[str, str] | None:
    event = Path("/sys/class/input") / name
    try:
        vendor = (event / "device/id/vendor").read_text().strip().lower()
        product = (event / "device/id/product").read_text().strip().lower()
    except OSError:
        return None
    return vendor, product


def steam_controllers() -> dict[str, int]:
    controllers = {}
    for event in Path("/sys/class/input").glob("event*"):
        try:
            identity = input_identity(event.name)
            source = Path("/dev/input") / event.name
            info = source.stat()
        except OSError:
            continue
        if identity == (STEAM_VENDOR, STEAM_PRODUCT) and stat.S_ISCHR(info.st_mode):
            controllers[event.name] = info.st_rdev
    return controllers


def steam_controller_layout(root: Path) -> tuple[str, bytes] | None:
    # Steam emits Xbox 360 codes, not the handheld driver's face buttons or D-pad keys.
    source = root / "system/usr/keylayout/Vendor_045e_Product_028e.kl"
    try:
        return source.name, source.read_bytes()
    except OSError:
        pass
    return None


def sync_keylayout(root: Path, layout: tuple[str, bytes] | None) -> bool:
    directory = root / "data/system/devices/keylayout"
    target = directory / f"Vendor_{STEAM_VENDOR}_Product_{STEAM_PRODUCT}.kl"
    marker = directory / ".waydroid-manager-steam-layout"
    if layout is None:
        if not marker.exists():
            return False
        target.unlink(missing_ok=True)
        marker.unlink(missing_ok=True)
        return True

    source_name, content = layout
    try:
        current = target.read_bytes()
        selected = marker.read_text().strip()
    except OSError:
        current = b""
        selected = ""
    if current == content and selected == source_name:
        return False
    directory.mkdir(parents=True, exist_ok=True)
    target.write_bytes(content)
    target.chmod(0o644)
    marker.write_text(source_name + "\n")
    marker.chmod(0o644)
    return True


def publish_node(inputs: Path, name: str, device: int) -> None:
    destination = inputs / name
    try:
        info = destination.lstat()
        if stat.S_ISCHR(info.st_mode) and info.st_rdev == device:
            os.chown(destination, 0, ANDROID_INPUT_GID)
            destination.chmod(0o660)
            return
        destination.unlink()
    except FileNotFoundError:
        pass

    with tempfile.TemporaryDirectory(prefix=".waydroid-manager-", dir=inputs.parent) as staging:
        source = Path(staging) / name
        os.mknod(source, stat.S_IFCHR | 0o660, device)
        os.chown(source, 0, ANDROID_INPUT_GID)
        source.chmod(0o660)
        os.link(source, destination)


def remove_node(inputs: Path, name: str, device: int) -> None:
    try:
        info = (inputs / name).lstat()
        if stat.S_ISCHR(info.st_mode) and info.st_rdev == device:
            (inputs / name).unlink()
    except FileNotFoundError:
        pass


def sync(inputs: Path, controllers: dict[str, int], published: dict[str, int]) -> dict[str, int]:
    for name, device in published.items():
        if controllers.get(name) != device:
            remove_node(inputs, name, device)
    for name, device in controllers.items():
        publish_node(inputs, name, device)
    return controllers


def main() -> None:
    active_pid = None
    published: dict[str, int] = {}
    while True:
        pid = container_pid()
        if pid != active_pid:
            active_pid = pid
            published = {}
        if pid:
            root = Path("/proc") / pid / "root"
            inputs = root / "dev/input"
            try:
                controllers = steam_controllers()
                if sync_keylayout(root, steam_controller_layout(root)):
                    for name, device in controllers.items():
                        remove_node(inputs, name, device)
                    published = {}
                published = sync(inputs, controllers, published)
            except OSError:
                published = {}
        time.sleep(1)


if __name__ == "__main__":
    main()
