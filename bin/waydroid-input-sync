#!/usr/bin/python3
from pathlib import Path
import signal
import os
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "py_modules"))
from waydroid_manager.container import registered_guest
from waydroid_manager.proc import process_identity
from waydroid_manager.input import InputNodes, RuntimeKeylayout, controller_sources
from waydroid_manager.file_events import FileEvents, process_handle


def main() -> None:
    launch = (int(sys.argv[1]), sys.argv[2])
    display = Path(sys.argv[3])
    active = None
    layout = nodes = None
    stopping = False
    last_error = None
    changes = FileEvents([Path("/dev/input"), Path("/run/udev"), Path("/run/udev/data")])
    launch_handle = process_handle(launch)
    guest_handle = None

    def stop(*_):
        nonlocal stopping
        stopping = True
        changes.wake()

    def release():
        nonlocal layout, nodes
        if active and process_identity(active[0]) != active:
            layout = nodes = None
            return
        if nodes:
            try:
                nodes.close(controller_sources()[1])
                nodes = None
            except (OSError, RuntimeError) as error:
                print(f"Waydroid input cleanup failed: {error}", file=sys.stderr, flush=True)
        if layout and nodes is None:
            try:
                layout.close()
                layout = None
            except (OSError, RuntimeError) as error:
                print(f"Waydroid layout cleanup failed: {error}", file=sys.stderr, flush=True)

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, stop)
    try:
        while not stopping and process_identity(launch[0]) == launch:
            try:
                current = registered_guest(display)
                pid = current[0] if current else None
                if current != active:
                    if guest_handle is not None:
                        os.close(guest_handle)
                        guest_handle = None
                    release()
                    if nodes or layout:
                        raise RuntimeError("Previous Android input setup is still active")
                    active = current
                    if active:
                        guest_handle = process_handle(active)
                controllers, shared = controller_sources() if pid else ({}, {})
                if controllers:
                    if layout is None:
                        root = Path("/proc") / str(pid) / "root"
                        layout = RuntimeKeylayout(pid, root)
                        layout.open()
                        nodes = InputNodes(root)
                    nodes.sync(controllers, shared)
                else:
                    release()
                last_error = None
            except (OSError, RuntimeError) as error:
                if str(error) != last_error:
                    print(f"Waydroid input unavailable: {error}", file=sys.stderr, flush=True)
                last_error = str(error)
                release()
            handles = [handle for handle in (launch_handle, guest_handle) if handle is not None]
            changes.refresh()
            changes.wait(handles, timeout=None if active and len(handles) == 2 and last_error is None else 1)
    finally:
        try:
            release()
        finally:
            for handle in (launch_handle, guest_handle):
                if handle is not None:
                    os.close(handle)
            changes.close()


if __name__ == "__main__":
    main()
