#!/usr/bin/python3
from pathlib import Path
import signal
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "py_modules"))
from waydroid_manager.container import container_pid
from waydroid_manager.proc import active_launch
from waydroid_manager.input import InputNodes, RuntimeKeylayout, controller_sources


def main() -> None:
    uid = int(sys.argv[1])
    relay = Path(__file__).resolve().with_name("waydroid-wayland-relay")
    active = None
    layout = nodes = None
    stopping = False
    last_error = None

    def stop(*_):
        nonlocal stopping
        stopping = True

    def release():
        nonlocal layout, nodes
        if nodes:
            try:
                nodes.close(controller_sources()[1])
                nodes = None
            except (OSError, RuntimeError) as error:
                print(f"Waydroid input cleanup failed: {error}", file=sys.stderr, flush=True)
        if layout and nodes is None:
            try:
                layout.close()
                layout = None
            except (OSError, RuntimeError) as error:
                print(f"Waydroid layout cleanup failed: {error}", file=sys.stderr, flush=True)

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, stop)
    try:
        while not stopping:
            try:
                launch = active_launch(uid, relay)
                pid = container_pid() if launch else None
                current = (launch, pid)
                if current != active:
                    release()
                    if nodes or layout:
                        raise RuntimeError("Previous Android input setup is still active")
                    active = current
                controllers, shared = controller_sources() if pid else ({}, {})
                if controllers:
                    if layout is None:
                        root = Path("/proc") / str(pid) / "root"
                        layout = RuntimeKeylayout(pid, root)
                        layout.open()
                        nodes = InputNodes(root)
                    nodes.sync(controllers, shared)
                else:
                    release()
                last_error = None
            except (OSError, RuntimeError) as error:
                if str(error) != last_error:
                    print(f"Waydroid input unavailable: {error}", file=sys.stderr, flush=True)
                last_error = str(error)
                release()
            time.sleep(1)
    finally:
        release()


if __name__ == "__main__":
    main()
