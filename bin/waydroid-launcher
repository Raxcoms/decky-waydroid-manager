#!/usr/bin/env bash
set -euo pipefail

mode="${1:-full}"
package="${2:-}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
parent_display="${DISPLAY:-}"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/waydroid-manager"
mkdir -p "$log_dir"

if ! command -v gamescope >/dev/null; then
  echo "Gamescope is required by Waydroid Manager." >&2
  exit 1
fi

if [[ -z "$parent_display" ]]; then
  echo "Waydroid Manager needs Steam's active Game Mode display." >&2
  exit 1
fi

if ! systemctl is-active --quiet waydroid-container.service; then
  echo "Waydroid is stopped. Enable Keep service warm in Waydroid Manager before launching from Steam." >&2
  exit 1
fi

export XDG_RUNTIME_DIR="$runtime_dir"
export WAYDROID_MANAGER_MODE="$mode"
export WAYDROID_MANAGER_PACKAGE="$package"
export WAYDROID_MANAGER_LOG_DIR="$log_dir"
unset WAYLAND_DISPLAY GAMESCOPE_WAYLAND_DISPLAY

# SDL uses Steam's active Xwayland display after Wayland variables are cleared.
exec gamescope --backend sdl --expose-wayland --fullscreen --force-windows-fullscreen -- bash -c '
  set -euo pipefail
  export WAYLAND_DISPLAY="${GAMESCOPE_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY:-}}"
  if [ -z "$WAYLAND_DISPLAY" ]; then
    echo "Nested Gamescope did not expose a Wayland socket." >&2
    exit 1
  fi
  waydroid session stop >/dev/null 2>&1 || true
  waydroid session start >>"$WAYDROID_MANAGER_LOG_DIR/session.log" 2>&1 &
  for _ in {1..30}; do
    if waydroid status 2>/dev/null | grep -q "^Session:[[:space:]]*RUNNING"; then
      break
    fi
    sleep 1
  done
  if ! waydroid status 2>/dev/null | grep -q "^Session:[[:space:]]*RUNNING"; then
    echo "Waydroid session did not start. See $WAYDROID_MANAGER_LOG_DIR/session.log" >&2
    exit 1
  fi
  if [ "$WAYDROID_MANAGER_MODE" = "app" ]; then
    exec waydroid app launch "$WAYDROID_MANAGER_PACKAGE"
  fi
  exec waydroid show-full-ui
'
