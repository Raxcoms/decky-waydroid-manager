#!/usr/bin/env bash
set -euo pipefail

mode="${1:-full}"
package="${2:-}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
parent_display="${DISPLAY:-}"
parent_wayland="${GAMESCOPE_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY:-}}"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/waydroid-manager"
launcher_dir="$(cd "$(dirname "$0")" && pwd)"
session_runner="$launcher_dir/waydroid-session"
steam_owner_pid="${WAYDROID_MANAGER_STEAM_OWNER_PID:-}"
if [[ -z "$steam_owner_pid" && -n "${SteamAppId:-}${SteamGameId:-}" ]]; then
  steam_owner_pid="$PPID"
fi
mkdir -p "$log_dir"

if [[ "${WAYDROID_MANAGER_CLEAN_ENV:-}" != 1 ]]; then
  exec env -i \
    WAYDROID_MANAGER_CLEAN_ENV=1 \
    HOME="$HOME" USER="${USER:-$(id -un)}" LOGNAME="${LOGNAME:-${USER:-$(id -un)}}" \
    PATH="${PATH:-/usr/local/bin:/usr/bin}" \
    LANG="${LANG:-C.UTF-8}" \
    XDG_RUNTIME_DIR="$runtime_dir" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
    DISPLAY="$parent_display" XAUTHORITY="${XAUTHORITY:-}" \
    GAMESCOPE_WAYLAND_DISPLAY="$parent_wayland" WAYLAND_DISPLAY="$parent_wayland" \
    GAMESCOPE_LIMITER_FILE="${GAMESCOPE_LIMITER_FILE:-}" \
    SteamAppId="${SteamAppId:-}" SteamGameId="${SteamGameId:-}" \
    XDG_STATE_HOME="${XDG_STATE_HOME:-}" \
    WAYDROID_MANAGER_SESSION_RUNNER="$session_runner" \
    WAYDROID_MANAGER_STEAM_OWNER_PID="$steam_owner_pid" \
    "$0" "$@"
fi

if [[ -z "$parent_display" ]]; then
  echo "Waydroid Manager needs Steam's active Game Mode display." >&2
  exit 1
fi

if [[ -z "$parent_wayland" ]]; then
  echo "Waydroid Manager needs Steam's active Game Mode Wayland socket." >&2
  exit 1
fi

if ! systemctl is-active --quiet waydroid-container.service; then
  "$launcher_dir/waydroid-service"
fi

export XDG_RUNTIME_DIR="$runtime_dir"
export WAYDROID_MANAGER_MODE="$mode"
export WAYDROID_MANAGER_PACKAGE="$package"
export WAYDROID_MANAGER_LOG_DIR="$log_dir"
export WAYDROID_MANAGER_SESSION_RUNNER="$session_runner"
export WAYDROID_MANAGER_SESSION_UNIT="waydroid-manager-session"
unset ENABLE_GAMESCOPE_WSI
export DISABLE_GAMESCOPE_WSI=1

# A private socket keeps Android attached to this Steam launch without rendering it again.
: >"$log_dir/wayland.log"
"$launcher_dir/waydroid-wayland-relay" "$parent_wayland" -- bash -c '
  set -euo pipefail
  export WAYLAND_DISPLAY="${GAMESCOPE_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY:-}}"
  if [ -z "$WAYLAND_DISPLAY" ]; then
    echo "The Waydroid Wayland relay did not expose a socket." >&2
    exit 1
  fi
  session_unit="$WAYDROID_MANAGER_SESSION_UNIT"
  owns_session=0
  steam_owner_pid="${WAYDROID_MANAGER_STEAM_OWNER_PID:-}"
  process_is_running() {
    [ -r "/proc/$1/stat" ] && [ "$(awk "{print \$3}" "/proc/$1/stat")" != Z ]
  }
  cleanup_session() {
    trap - EXIT HUP INT TERM
    if [ "$owns_session" = 1 ]; then
      systemctl --user stop "$session_unit" >/dev/null 2>&1 || true
    fi
  }
  trap cleanup_session EXIT HUP INT TERM
  systemctl --user stop "$session_unit" >/dev/null 2>&1 || true
  # Reconnect Android to the private socket for each launch.
  if waydroid status 2>/dev/null | grep -q "^Session:[[:space:]]*RUNNING"; then
    waydroid session stop >/dev/null 2>&1 || true
    for _ in {1..30}; do
      waydroid status 2>/dev/null | grep -q "^Session:[[:space:]]*RUNNING" || break
      sleep 1
    done
  fi
  if waydroid status 2>/dev/null | grep -q "^Session:[[:space:]]*RUNNING"; then
    echo "The previous Waydroid session did not stop." >&2
    exit 1
  fi
  rm -f "$WAYDROID_MANAGER_LOG_DIR/android-ready"
  for attempt in {1..45}; do
    if waydroid status 2>/dev/null | grep -q "^Session:[[:space:]]*RUNNING"; then
      break
    fi
    if (( attempt == 1 )); then
      systemd-run --user --collect --quiet --unit="$session_unit" \
        --property=KillMode=control-group \
        --setenv="HOME=$HOME" \
        --setenv="USER=$USER" \
        --setenv="LOGNAME=$LOGNAME" \
        --setenv="PATH=$PATH" \
        --setenv="XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" \
        --setenv="XDG_STATE_HOME=${XDG_STATE_HOME:-}" \
        --setenv="DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" \
        --setenv="DISPLAY=$DISPLAY" \
        --setenv="XAUTHORITY=${XAUTHORITY:-}" \
        --setenv="GAMESCOPE_WAYLAND_DISPLAY=$GAMESCOPE_WAYLAND_DISPLAY" \
        --setenv="WAYLAND_DISPLAY=$WAYLAND_DISPLAY" \
        --setenv="WAYDROID_MANAGER_LOG_DIR=$WAYDROID_MANAGER_LOG_DIR" \
        "$WAYDROID_MANAGER_SESSION_RUNNER" "$$"
      owns_session=1
    fi
    sleep 1
  done
  if ! waydroid status 2>/dev/null | grep -q "^Session:[[:space:]]*RUNNING"; then
    echo "Waydroid session did not start. See $WAYDROID_MANAGER_LOG_DIR/session.log" >&2
    exit 1
  fi
  if [ "$owns_session" = 1 ]; then
    for _ in {1..180}; do
      [ -f "$WAYDROID_MANAGER_LOG_DIR/android-ready" ] && break
      sleep 1
    done
    if [ ! -f "$WAYDROID_MANAGER_LOG_DIR/android-ready" ]; then
      echo "Android did not become ready. See $WAYDROID_MANAGER_LOG_DIR/session.log" >&2
      exit 1
    fi
  fi
  for _ in {1..20}; do
    if waydroid app list 2>/dev/null | grep -q "^Name:"; then
      break
    fi
    if [ "$WAYDROID_MANAGER_MODE" = "full" ]; then
      waydroid show-full-ui || true
    else
      timeout 10 waydroid app launch "$WAYDROID_MANAGER_PACKAGE" >>"$WAYDROID_MANAGER_LOG_DIR/app.log" 2>&1 || true
    fi
    sleep 3
  done
  if [ "$WAYDROID_MANAGER_MODE" = "app" ]; then
    for _ in {1..5}; do
      if timeout 15 waydroid app launch "$WAYDROID_MANAGER_PACKAGE" >>"$WAYDROID_MANAGER_LOG_DIR/app.log" 2>&1; then
        break
      fi
      sleep 3
    done
  else
    waydroid show-full-ui
  fi
  while :; do
    if [ -n "$steam_owner_pid" ] && ! process_is_running "$steam_owner_pid"; then
      exit 0
    fi
    sleep 3600 &
    if [ -n "$steam_owner_pid" ]; then
      for _ in {1..3600}; do
        process_is_running "$steam_owner_pid" || exit 0
        sleep 1
      done
      wait "$!"
    else
      wait "$!"
    fi
  done
' >>"$log_dir/wayland.log" 2>&1 &
host_pid=$!

stop_host() {
  trap - EXIT HUP INT TERM
  systemctl --user stop "$WAYDROID_MANAGER_SESSION_UNIT" >/dev/null 2>&1 || true
  if kill -0 "$host_pid" 2>/dev/null; then
    kill -TERM "$host_pid" 2>/dev/null || true
    for _ in {1..60}; do
      [[ ! -r "/proc/$host_pid/stat" ]] && break
      [[ "$(awk '{print $3}' "/proc/$host_pid/stat" 2>/dev/null)" == Z ]] && break
      sleep 0.1
    done
    kill -KILL "$host_pid" 2>/dev/null || true
    wait "$host_pid" 2>/dev/null || true
  fi
}

trap stop_host EXIT HUP INT TERM
while kill -0 "$host_pid" 2>/dev/null; do
  if [ -n "$steam_owner_pid" ] && { [ ! -r "/proc/$steam_owner_pid/stat" ] || [ "$(awk '{print $3}' "/proc/$steam_owner_pid/stat" 2>/dev/null)" = Z ]; }; then
    exit 0
  fi
  sleep 1
done
wait "$host_pid" || true
