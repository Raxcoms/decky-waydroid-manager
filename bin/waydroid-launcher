#!/usr/bin/env bash
set -euo pipefail

mode="${1:-full}"
package="${2:-}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
parent_display="${DISPLAY:-}"
parent_wayland="${GAMESCOPE_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY:-}}"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/waydroid-manager"
launcher_dir="$(cd "$(dirname "$0")" && pwd)"
session_runner="$launcher_dir/waydroid-session"
steam_owner_pid="${WAYDROID_MANAGER_STEAM_OWNER_PID:-}"
if [[ -z "$steam_owner_pid" && -n "${SteamAppId:-}${SteamGameId:-}" ]]; then
  steam_owner_pid="$PPID"
fi
if [[ "${WAYDROID_MANAGER_CLEAN_ENV:-}" != 1 ]]; then
  exec env -i \
    WAYDROID_MANAGER_CLEAN_ENV=1 \
    HOME="$HOME" USER="${USER:-$(id -un)}" LOGNAME="${LOGNAME:-${USER:-$(id -un)}}" \
    PATH="${PATH:-/usr/local/bin:/usr/bin}" \
    LANG="${LANG:-C.UTF-8}" \
    XDG_RUNTIME_DIR="$runtime_dir" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
    DISPLAY="$parent_display" XAUTHORITY="${XAUTHORITY:-}" \
    GAMESCOPE_WAYLAND_DISPLAY="$parent_wayland" WAYLAND_DISPLAY="$parent_wayland" \
    SteamAppId="${SteamAppId:-}" SteamGameId="${SteamGameId:-}" \
    XDG_STATE_HOME="${XDG_STATE_HOME:-}" \
    WAYDROID_MANAGER_STEAM_OWNER_PID="$steam_owner_pid" \
    "$0" "$@"
fi

parent_socket="$parent_wayland"
if [[ "$parent_socket" != /* ]]; then
  parent_socket="$runtime_dir/$parent_socket"
fi
if [[ ! -S "$parent_socket" ]]; then
  echo "Waydroid Manager needs Steam's active Game Mode Wayland socket." >&2
  exit 1
fi
exec 9>"$runtime_dir/waydroid-manager-launch.lock"
if ! flock -n 9; then
  echo "Close the running Waydroid shortcut before launching another." >&2
  exit 1
fi
mkdir -p "$log_dir"

if ! systemctl is-active --quiet waydroid-container.service; then
  "$launcher_dir/waydroid-service"
fi

export XDG_RUNTIME_DIR="$runtime_dir"
export WAYDROID_MANAGER_MODE="$mode"
export WAYDROID_MANAGER_PACKAGE="$package"
export WAYDROID_MANAGER_LOG_DIR="$log_dir"
export WAYDROID_MANAGER_SESSION_RUNNER="$session_runner"
export WAYDROID_MANAGER_SESSION_UNIT="waydroid-manager-session"
unset ENABLE_GAMESCOPE_WSI
export DISABLE_GAMESCOPE_WSI=1

# A private socket keeps Android attached to this Steam launch without rendering it again.
: >"$log_dir/wayland.log"
if [[ "$mode" == app ]]; then
  : >"$log_dir/app.log"
fi
"$launcher_dir/waydroid-wayland-relay" "$parent_wayland" -- \
  "$launcher_dir/waydroid-game-session" >>"$log_dir/wayland.log" 2>&1 &
host_pid=$!

stop_host() {
  trap - EXIT HUP INT TERM
  systemctl --user stop "$WAYDROID_MANAGER_SESSION_UNIT" >/dev/null 2>&1 || true
  if kill -0 "$host_pid" 2>/dev/null; then
    kill -TERM "$host_pid" 2>/dev/null || true
    for _ in {1..60}; do
      [[ ! -r "/proc/$host_pid/stat" ]] && break
      [[ "$(awk '{print $3}' "/proc/$host_pid/stat" 2>/dev/null)" == Z ]] && break
      sleep 0.1
    done
    kill -KILL "$host_pid" 2>/dev/null || true
    wait "$host_pid" 2>/dev/null || true
  fi
}

trap stop_host EXIT HUP INT TERM
while kill -0 "$host_pid" 2>/dev/null; do
  if [ -n "$steam_owner_pid" ] && { [ ! -r "/proc/$steam_owner_pid/stat" ] || [ "$(awk '{print $3}' "/proc/$steam_owner_pid/stat" 2>/dev/null)" = Z ]; }; then
    exit 0
  fi
  sleep 1
done
wait "$host_pid"
