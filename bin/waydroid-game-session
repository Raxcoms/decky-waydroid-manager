#!/usr/bin/env bash
set -euo pipefail

parent_wayland="${1:?missing Game Mode Wayland socket}"
session_unit="$WAYDROID_MANAGER_SESSION_UNIT"
steam_owner_pid="${WAYDROID_MANAGER_STEAM_OWNER_PID:-}"
launch_dir="$WAYDROID_MANAGER_LAUNCH_DIR"
launch_file=""

process_running() {
  [ -r "/proc/$1/stat" ] && [ "$(awk '{print $3}' "/proc/$1/stat")" != Z ]
}

prune_launches() {
  local file owner
  shopt -s nullglob
  for file in "$launch_dir"/*; do
    read -r owner <"$file" || owner=""
    if ! [[ "$owner" =~ ^[0-9]+$ ]] || ! process_running "$owner"; then
      rm -f "$file"
    fi
  done
  shopt -u nullglob
}

has_launches() {
  shopt -s nullglob
  local files=("$launch_dir"/*)
  shopt -u nullglob
  [ "${#files[@]}" -gt 0 ]
}

unit_running() {
  local state
  state=$(systemctl --user show --property=ActiveState --value "$session_unit" 2>/dev/null) || return 1
  [ "$state" = "active" ] || [ "$state" = "activating" ]
}

wait_for_android() {
  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if ! unit_running; then
      return 1
    fi
    if waydroid app list 2>/dev/null | grep -q '^Name:'; then
      return 0
    fi
    sleep 1
  done
  return 1
}

start_session() {
  : >"$WAYDROID_MANAGER_LOG_DIR/wayland.log"
  systemd-run --user --collect --quiet --unit="$session_unit" \
    --property=KillMode=control-group --property=TimeoutStopSec=45s \
    --setenv="HOME=$HOME" --setenv="USER=$USER" --setenv="LOGNAME=$LOGNAME" --setenv="PATH=$PATH" \
    --setenv="XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" --setenv="XDG_STATE_HOME=${XDG_STATE_HOME:-}" \
    --setenv="DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" \
    --setenv="WAYDROID_MANAGER_LOG_DIR=$WAYDROID_MANAGER_LOG_DIR" \
    "$(dirname "$0")/waydroid-wayland-relay" "$parent_wayland" -- "$WAYDROID_MANAGER_SESSION_RUNNER" \
    >>"$WAYDROID_MANAGER_LOG_DIR/wayland.log" 2>&1
}

release_launch() {
  trap - EXIT HUP INT TERM
  if [ "$WAYDROID_MANAGER_MODE" = "app" ] && [ -n "${launched:-}" ]; then
    timeout 15 waydroid shell -- am force-stop "$WAYDROID_MANAGER_PACKAGE" >>"$WAYDROID_MANAGER_LOG_DIR/app.log" 2>&1 || true
  fi
  flock 9
  rm -f "$launch_file"
  prune_launches
  if ! has_launches; then
    systemctl --user stop "$session_unit" >/dev/null 2>&1 || true
  fi
}

trap release_launch EXIT
trap 'exit 1' HUP INT TERM
mkdir -p "$launch_dir"
exec 9>"$XDG_RUNTIME_DIR/waydroid-manager-session.lock"
flock 9
prune_launches
if ! has_launches && unit_running; then
  systemctl --user stop "$session_unit" >/dev/null 2>&1 || true
fi
launch_file=$(mktemp "$launch_dir/launch.XXXXXX")
printf '%s\n' "${steam_owner_pid:-$$}" >"$launch_file"
if ! unit_running; then
  start_session
fi
flock -u 9

if ! wait_for_android; then
  echo "Android did not become ready. See $WAYDROID_MANAGER_LOG_DIR/session.log" >&2
  exit 1
fi
if [ "$WAYDROID_MANAGER_MODE" = "app" ]; then
  : >"$WAYDROID_MANAGER_LOG_DIR/app.log"
  if ! timeout 15 waydroid app launch "$WAYDROID_MANAGER_PACKAGE" >>"$WAYDROID_MANAGER_LOG_DIR/app.log" 2>&1; then
    echo "Android app did not launch. See $WAYDROID_MANAGER_LOG_DIR/app.log" >&2
    exit 1
  fi
  launched=1
else
  if ! timeout 15 waydroid show-full-ui; then
    echo "Waydroid did not open. See $WAYDROID_MANAGER_LOG_DIR/session.log" >&2
    exit 1
  fi
fi
while [ -z "$steam_owner_pid" ] || process_running "$steam_owner_pid"; do
  sleep 1
done
