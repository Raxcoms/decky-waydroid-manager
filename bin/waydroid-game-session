#!/usr/bin/env bash
set -euo pipefail

export WAYLAND_DISPLAY="${GAMESCOPE_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY:?missing Waydroid relay socket}}"
session_unit="$WAYDROID_MANAGER_SESSION_UNIT"
steam_owner_pid="${WAYDROID_MANAGER_STEAM_OWNER_PID:-}"
owns_session=0
service_helper="$(dirname "$0")/waydroid-service"

unit_active() {
  timeout 5 systemctl --user is-active --quiet "$session_unit"
}

owned_session_running() {
  local status
  status=$(timeout 5 waydroid status 2>/dev/null) || return 1
  grep -qE '^Container:[[:space:]]*(RUNNING|FREEZING|FROZEN)$' <<<"$status" &&
    awk -v display="$WAYLAND_DISPLAY" '/^Wayland display:/ {sub(/^Wayland display:[[:space:]]*/, ""); found = ($0 == display)} END {exit !found}' <<<"$status"
}

cleanup_session() {
  if [ "$owns_session" = 1 ]; then
    if ! "$service_helper" --release; then
      timeout 10 systemctl --user stop "$session_unit" || true
    fi
  fi
}
trap cleanup_session EXIT
trap 'exit 1' HUP INT TERM

status=$(timeout 5 waydroid status)
if ! grep -qE '^Session:[[:space:]]*STOPPED$' <<<"$status"; then
  echo "Close the running Waydroid session before launching this shortcut." >&2
  exit 1
fi

systemd-run --user --collect --quiet --unit="$session_unit" \
  --property=KillMode=control-group --property=TimeoutStopSec=45s \
  --setenv="HOME=$HOME" --setenv="USER=$USER" --setenv="LOGNAME=$LOGNAME" --setenv="PATH=$PATH" \
  --setenv="XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" --setenv="XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}" \
  --setenv="DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS" \
  --setenv="WAYLAND_DISPLAY=$WAYLAND_DISPLAY" \
  --setenv="WAYDROID_MANAGER_LOG_DIR=$WAYDROID_MANAGER_LOG_DIR" \
  "$WAYDROID_MANAGER_SESSION_RUNNER"
owns_session=1

deadline=$((SECONDS + 180))
ready=0
while (( SECONDS < deadline )) && unit_active; do
  # Presentation commands can start a new session, so only query readiness here.
  if owned_session_running && timeout 5 waydroid app list 2>/dev/null | grep '^Name:' >/dev/null; then
    # The app list can respond before Android has unlocked the current user.
    if "$service_helper" --policy "$WAYDROID_MANAGER_MODE"; then
      ready=1
      break
    else
      result=$?
      [ "$result" = 3 ] || exit "$result"
    fi
  fi
  sleep 1
done
if [ "$ready" = 0 ] || ! unit_active || ! owned_session_running; then
  echo "Android did not become ready. See $WAYDROID_MANAGER_LOG_DIR/session.log" >&2
  exit 1
fi
"$service_helper" --check-overlay || true

if [ "$WAYDROID_MANAGER_MODE" = "app" ]; then
  timeout 15 waydroid app launch "$WAYDROID_MANAGER_PACKAGE" >>"$WAYDROID_MANAGER_LOG_DIR/app.log" 2>&1
else
  timeout 15 waydroid show-full-ui
fi

while unit_active && owned_session_running; do
  if [ -n "$steam_owner_pid" ]; then
    state=$(awk '{print $3}' "/proc/$steam_owner_pid/stat" 2>/dev/null) || exit 0
    [ "$state" != Z ] || exit 0
  fi
  sleep 1
done
echo "Waydroid session ended. See $WAYDROID_MANAGER_LOG_DIR/session.log" >&2
exit 1
