--- a/pulse/pcm_pulse.c
+++ b/pulse/pcm_pulse.c
@@ -26,5 +26,6 @@
 #include <alsa/asoundlib.h>
 #include <alsa/pcm_external.h>
+#include <android/log.h>
 
 #include "pulse.h"
 
@@ -460,6 +461,10 @@
 
 	/* Make sure the buffer pointer is in sync */
+	if (writebytes > pcm->last_size)
+		__android_log_print(ANDROID_LOG_WARN, "WaydroidAudioProbe",
+			"underflow write=%zu last=%zu length=%u", writebytes,
+			pcm->last_size, pcm->buffer_attr.tlength);
 	pcm->last_size -= writebytes;
 	pcm->written += writebytes;
 	ret = update_ptr(pcm);
@@ -651,6 +656,17 @@
 	err = check_active(pcm);
 	if (err < 0)
 		goto finish;
+	static unsigned int probes;
+	if ((++probes & 1048575) == 0) {
+		__android_log_print(ANDROID_LOG_WARN, "WaydroidAudioProbe",
+			"active=%d writable=%zu minreq=%u hw=%lu app=%lu period=%lu buffer=%lu last=%zu ptr=%zu length=%u",
+			err, pa_stream_writable_size(pcm->stream), pcm->buffer_attr.minreq,
+			(unsigned long)io->hw_ptr, (unsigned long)io->appl_ptr,
+			(unsigned long)io->period_size, (unsigned long)io->buffer_size,
+			pcm->last_size, pcm->ptr, pcm->buffer_attr.tlength);
+	}
+	if (err == 0)
+		pulse_poll_deactivate(pcm->p);
 
 	if (err > 0)
 		*revents = io->stream == SND_PCM_STREAM_PLAYBACK ? POLLOUT : POLLIN;
