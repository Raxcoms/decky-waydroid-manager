 struct buffer;
 
+// Release events arrive on the display thread while the composer thread may be
+// destroying the buffer, so they find it by proxy under this lock.
+static std::mutex release_mutex;
+static std::unordered_map<struct wl_buffer *, buffer *> released_buffers;
+
+void track_buffer_release(buffer *buf, struct display *owner) {
+    static unsigned next_id;
+    std::lock_guard<std::mutex> lock(release_mutex);
+    buf->id = ++next_id;
+    buf->owner = owner;
+    buf->release_timeline = sw_sync_timeline_create();
+    released_buffers[buf->wl_buffer] = buf;
+}
+
+void buffer_released(struct wl_buffer *wl_buffer) {
+    std::lock_guard<std::mutex> lock(release_mutex);
+    auto it = released_buffers.find(wl_buffer);
+    if (it == released_buffers.end())
+        return;
+    buffer *buf = it->second;
+    if (buf->released_point < buf->release_point) {
+        sw_sync_timeline_inc(buf->release_timeline, buf->release_point - buf->released_point);
+        buf->released_point = buf->release_point;
+    }
+}
+
+int buffer::next_release_fence() {
+    std::lock_guard<std::mutex> lock(release_mutex);
+    if (release_timeline < 0 || (owner && !owner->connected))
+        return -1;
+    return sw_sync_fence_create(release_timeline, "wl_buffer_release", ++release_point);
+}
+
+int buffer::current_release_fence() {
+    std::lock_guard<std::mutex> lock(release_mutex);
+    if (release_timeline < 0)
+        return -1;
+    return sw_sync_fence_create(release_timeline, "wl_buffer_release", release_point);
+}
+
+bool buffer::in_use() {
+    std::lock_guard<std::mutex> lock(release_mutex);
+    return released_point < release_point;
+}
+
+void release_display_buffers(struct display *owner) {
+    std::lock_guard<std::mutex> lock(release_mutex);
+    for (auto &[proxy, buf] : released_buffers) {
+        if (buf->owner == owner && buf->released_point < buf->release_point) {
+            sw_sync_timeline_inc(buf->release_timeline, buf->release_point - buf->released_point);
+            buf->released_point = buf->release_point;
+        }
+    }
+}
+
+// Destroying a buffer would signal its fences while it may still be on screen
+void retire_buffers(struct display *d) {
+    for (auto &[handle, buf] : d->buffer_map)
+        d->retired_buffers.push_back(std::move(buf));
+    d->buffer_map.clear();
+}
+
+void purge_retired_buffers(struct display *d) {
+    auto &retired = d->retired_buffers;
+    retired.erase(std::remove_if(retired.begin(), retired.end(),
+                                 [](const std::unique_ptr<buffer> &buf) { return !buf->in_use(); }),
+                  retired.end());
+}
+
 buffer::~buffer() {
+    {
+        std::lock_guard<std::mutex> lock(release_mutex);
+        released_buffers.erase(wl_buffer);
+    }
     wl_buffer_destroy(wl_buffer);
+    // Closing the timeline signals any fence still pending on it
+    if (release_timeline >= 0)
+        close(release_timeline);
     if (isShm)
         munmap(shm_data, size);
 }
