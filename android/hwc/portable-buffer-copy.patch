+                                   android::GraphicBuffer::USAGE_HW_COMPOSER;
+            android::sp<android::GraphicBuffer> storage = new android::GraphicBuffer(
+                    metadata.width, metadata.height, metadata.format, 1, usage, "Waydroid Manager");
