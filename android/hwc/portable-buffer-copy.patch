+    buffer *copy_wl_buffer(waydroid_hwc_composer_device_1 *pdev, hwc_layer_1_t *layer,
+                           display *display, const buffer_metadata &metadata,
+                           const gralloc_handler &handler) {
+        buffer *candidate = nullptr;
