+bool egl_copy_to_buffer(struct display *display, buffer_handle_t source,
+                        const buffer_metadata &metadata, android::GraphicBuffer *target) {
+    android::sp<android::GraphicBuffer> input = new android::GraphicBuffer(
+            (native_handle_t *) source, android::GraphicBuffer::WRAP_HANDLE,
+            metadata.width, metadata.height, metadata.format, 1,
+            (uint64_t) android::GraphicBuffer::USAGE_HW_TEXTURE, metadata.pixel_stride);
+    const EGLint attrs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE };
+    EGLImageKHR src = eglCreateImageKHR(display->egl_dpy, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                                       (EGLClientBuffer) input->getNativeBuffer(), attrs);
+    EGLImageKHR dst = eglCreateImageKHR(display->egl_dpy, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                                       (EGLClientBuffer) target->getNativeBuffer(), attrs);
+    if (src == EGL_NO_IMAGE_KHR || dst == EGL_NO_IMAGE_KHR) {
+        if (src != EGL_NO_IMAGE_KHR) eglDestroyImageKHR(display->egl_dpy, src);
+        if (dst != EGL_NO_IMAGE_KHR) eglDestroyImageKHR(display->egl_dpy, dst);
+        return false;
+    }
+    GLuint textures[2];
+    glGenTextures(2, textures);
+    glBindTexture(GL_TEXTURE_2D, textures[0]);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, src);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textures[0], 0);
+    bool ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (ok) {
+        glBindTexture(GL_TEXTURE_2D, textures[1]);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, dst);
+        glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, metadata.width, metadata.height);
+        glFinish();
+        ok = glGetError() == GL_NO_ERROR;
+    }
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+    glDeleteTextures(2, textures);
+    eglDestroyImageKHR(display->egl_dpy, src);
+    eglDestroyImageKHR(display->egl_dpy, dst);
+    return ok;
+}
