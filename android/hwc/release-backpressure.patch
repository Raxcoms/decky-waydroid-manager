+    else if (pending)
+        release_gate.release(buf->id);
+}
+
+void queue_replaced_buffer(struct display *owner, unsigned id) {
+    auto token = release_gate.snapshot(id);
+    if (token) owner->pending_releases.push_back(token);
+}
+
+void wait_replaced_buffers(struct display *owner, int64_t timeout_ns) {
+    using namespace std::chrono;
+    if (!owner->pending_releases.empty()) {
+        // A stalled compositor must not leave Android waiting indefinitely.
+        auto timeout = std::min(nanoseconds(timeout_ns), duration_cast<nanoseconds>(seconds(1)));
+        auto result = owner->release_wait.wait(release_gate, owner->pending_releases, timeout);
+        if (result == waydroid_manager::ReleaseWaitResult::TimedOut)
+            ALOGW("Wayland buffer release timed out; using the unsynchronized fallback");
+    }
+    owner->pending_releases.clear();
 }
 
