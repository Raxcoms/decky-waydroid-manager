+struct TraceBucket {
+    std::atomic<uint64_t> count[8] {};
+    std::atomic<uint64_t> deviation[8] {};
+    std::atomic<uint64_t> maximum[8] {};
+};
+static TraceBucket trace_buckets[240];
+static std::atomic<int64_t> trace_origin {0};
+static std::atomic<int64_t> trace_previous[8] {};
+static void trace_event(unsigned kind, int64_t value = 0) {
+    timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) return;
+    int64_t when = int64_t(now.tv_sec) * 1000000000LL + now.tv_nsec;
+    int64_t zero = trace_origin.load();
+    if (!zero) {
+        trace_origin.compare_exchange_strong(zero, when);
+        zero = trace_origin.load();
+    }
+    int64_t second = (when - zero) / 1000000000LL;
+    if (second < 0 || second >= 240) return;
+    int64_t event = value ? value : when;
+    int64_t previous = trace_previous[kind].exchange(event);
+    auto &slot = trace_buckets[second];
+    ++slot.count[kind];
+    if (previous && event > previous) {
+        uint64_t delta = event - previous;
+        slot.deviation[kind] += delta > 8333333 ? delta - 8333333 : 8333333 - delta;
+        uint64_t maximum = slot.maximum[kind].load();
+        while (delta > maximum && !slot.maximum[kind].compare_exchange_weak(maximum, delta)) {}
+    }
+}
+
+static void trace_duration(unsigned kind, int64_t duration) {
+    int64_t second = (trace_time() - trace_origin.load()) / 1000000000LL;
+    if (second < 0 || second >= 240 || duration < 0) return;
+    auto &slot = trace_buckets[second];
+    ++slot.count[kind];
+    slot.deviation[kind] += duration;
+    uint64_t maximum = slot.maximum[kind].load();
+    while (uint64_t(duration) > maximum && !slot.maximum[kind].compare_exchange_weak(maximum, duration)) {}
+}
